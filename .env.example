# Identificador da Fazenda / Cliente (Obrigatório em produção para identidade visual)
# Opções cadastradas: agro3mil | haras-luma | nelore-indi-ouro
NEXT_PUBLIC_TENANT_ID=nome_fazenda

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key used to permanently delete Supabase Auth users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional Configurations
NEXT_PUBLIC_SYNC_SAFE_MODE=false
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false
